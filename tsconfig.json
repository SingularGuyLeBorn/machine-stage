{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "three.quarks": ["./vendor/three.quarks/types/index.d.ts"],
      "quarks.core": ["./vendor/quarks.core/types/index.d.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vendor", "vite.config.ts", "vitest.config.ts"]
}
